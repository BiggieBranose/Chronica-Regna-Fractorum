# ============================================================================
# Chronica Regna Fractorum — .gitignore
#
# C++20 / CMake / Vulkan / MinGW project
# ============================================================================

# ---- Build output ----------------------------------------------------------
**/build/
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj

# ---- CMake generated -------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
build.ninja
rules.ninja
.ninja_deps
.ninja_log

# ---- Compiled shaders ------------------------------------------------------
*.spv

# ---- Engine runtime --------------------------------------------------------
engine.log

# ---- External libraries (header-only, not tracked) -------------------------
# If you add header-only libs to Code/external/, they should be tracked.
# This rule is a safety net for accidentally downloaded binaries.
Code/external/**/*.lib
Code/external/**/*.dll
Code/external/**/*.a
Code/external/**/*.exe

# ---- IDE / Editor ----------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.vs/
*.suo
*.user
*.sln.docstates

# ---- OS generated ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Miscellaneous ---------------------------------------------------------
*.log
*.tmp
*.bak
*.cache
*.pdb
*.ilk
*.ipdb
*.iobj
